# Copy to .env.local for `pnpm dev`.
# Deployed values live in Netlify environment variables (Site configuration → Environment variables), never in git.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Build-time: Cloudflare Web Analytics site token (Web Analytics → Add site). Empty = no analytics beacon.
NEXT_PUBLIC_CF_BEACON_TOKEN=
# Build-time: Discord invite link for the home page community section. Empty = section hidden.
NEXT_PUBLIC_DISCORD_URL=
# Numeric GitHub user id of the site owner; unlocks /admin. Empty = admin hidden for everyone.
ADMIN_GITHUB_ID=
# Optional, build-time: ISO date the 30-Day Challenge opens. Empty = 2026-12-01T00:00:00+05:30.
NEXT_PUBLIC_CHALLENGE_OPENS_AT=
