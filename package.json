{
  "name": "rust-learn",
  "version": "4.3.10",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/sync-sw-version.js && node scripts/generate-content-hash.js && next build",
    "sync-content": "bash scripts/sync-content.sh",
    "sync-100-rust-projects": "bash scripts/sync-100-rust-projects.sh && node scripts/build-100-projects-manifest.js",
    "version": "node scripts/sync-sw-version.js && git add public/sw.js",
    "version:patch": "pnpm version patch",
    "version:minor": "pnpm version minor",
    "version:major": "pnpm version major",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "npx auth@latest migrate --yes && tsx --env-file=.env.local db/migrate.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@libsql/client": "^0.17.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "flexsearch": "^0.8.212",
    "kysely": "^0.28.14",
    "kysely-libsql": "^0.7.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.7.0",
    "mermaid": "^11.13.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/hast": "^3.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "browserslist": [
    "last 1 Chrome version",
    "last 1 Firefox version",
    "last 1 Safari version",
    "last 1 Edge version"
  ],
  "pnpm": {
    "ignoredBuiltDependencies": [
      "msw",
      "sharp",
      "unrs-resolver"
    ],
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
